{
  "name": "kobo-ebooks-update-checker",
  "version": "1.8.0",
  "description": "Checks if updates were available for the e-books you own.",
  "homepage": "https://github.com/JasonHK/kobo-ebooks-update-checker#readme",
  "bugs": {
    "url": "https://github.com/JasonHK/kobo-ebooks-update-checker/issues"
  },
  "license": "MIT",
  "author": {
    "email": "userscripts@jasonhk.dev",
    "name": "Jason Kwok"
  },
  "main": "kobo-update-checker.user.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonHK/kobo-ebooks-update-checker.git"
  },
  "scripts": {
    "build": "$npm_execpath run locales -- --no-watch && tsc && vite build",
    "dev": "vite",
    "locales": "typesafe-i18n",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "preact": "^10.29.1",
    "preact-root-fragment": "^0.3.1",
    "queue": "^7.0.0",
    "typesafe-i18n": "^5.27.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^25.6.0",
    "sass-embedded": "^1.99.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vite-plugin-monkey": "^7.1.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": "12.x"
    }
  },
  "private": true,
  "type": "module"
}
