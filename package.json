{
  "name": "kobo-ebooks-update-checker",
  "version": "2.1.0",
  "description": "Checks if updates were available for the e-books you own.",
  "homepage": "https://github.com/JasonHK/kobo-ebooks-update-checker#readme",
  "bugs": {
    "url": "https://github.com/JasonHK/kobo-ebooks-update-checker/issues"
  },
  "license": "GPL-3.0",
  "author": {
    "email": "userscripts@jasonhk.dev",
    "name": "Jason Kwok"
  },
  "main": "kobo-update-checker.user.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonHK/kobo-ebooks-update-checker.git"
  },
  "scripts": {
    "build": "pnpm run locales --no-watch && tsc && vite build",
    "dev": "vite",
    "locales": "typesafe-i18n",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.8.2",
    "queue": "^7.0.0",
    "typesafe-i18n": "^5.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^25.9.9",
    "jsdom": "^30.1.3",
    "sass-embedded": "^1.107.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": "12.x"
    }
  },
  "private": true,
  "type": "module"
}
